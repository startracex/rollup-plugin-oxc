{
  "name": "rollup-plugin-oxc",
  "version": "0.7.1",
  "description": "A Rollup plugin to resolve, transform, minify TypeScript and generate type declarations with oxc.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "check": "oxlint && oxfmt --check"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.5.1",
    "oxc-minify": "^0.157.0",
    "oxc-resolver": "^11.24.2",
    "oxc-transform": "^0.157.0",
    "tsconfck": "^3.1.6",
    "tsconfig-migrate": "^0.3.0"
  },
  "devDependencies": {
    "@startracex/dev-config": "^0.7.0",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "rollup": "^4.67.5",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "require": "./build/index.cjs"
    },
    "./*.js": {
      "types": "./build/*.d.ts",
      "import": "./build/*.js",
      "require": "./build/*.cjs"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "files": [
    "build",
    "src"
  ],
  "keywords": [
    "rollup",
    "plugin",
    "oxc",
    "transform",
    "resolve",
    "minify",
    "typescript",
    "dts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/startracex/rollup-plugin-oxc.git"
  },
  "author": "startracex",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0"
}
