{
  "name": "rollup-plugin-oxc",
  "version": "0.7.1",
  "description": "A Rollup plugin to resolve, transform, minify TypeScript and generate type declarations with oxc.",
  "type": "module",
  "scripts": {
    "build": "rollup -c"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.3.0",
    "oxc-minify": "^0.108.0",
    "oxc-resolver": "^11.16.2",
    "oxc-transform": "^0.108.0",
    "tsconfck": "^3.1.6",
    "tsconfig-migrate": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.6",
    "rollup": "^4.55.1",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "require": "./build/index.cjs"
    },
    "./*.js": {
      "types": "./build/*.d.ts",
      "import": "./build/*.js",
      "require": "./build/*.cjs"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "files": [
    "build",
    "src"
  ],
  "keywords": [
    "rollup",
    "plugin",
    "oxc",
    "transform",
    "resolve",
    "minify",
    "typescript",
    "dts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/startracex/rollup-plugin-oxc.git"
  },
  "author": "startracex",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0"
}
